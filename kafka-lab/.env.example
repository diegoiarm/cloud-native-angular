# Variables de los servicios Kafka (valores de laboratorio, sin secretos).
# Lo normal es no definir ninguna: los valores por defecto ya cubren el
# laboratorio de un broker, y el perfil "cluster" cubre el cluster de 3 brokers.

# Perfil: vacío = un broker (compose.yaml) | cluster = 3 brokers (compose.cluster.yaml)
SPRING_PROFILES_ACTIVE=cluster

# Conexión (el perfil cluster ya usa estos tres brokers)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_PARTICIONES=3
KAFKA_REPLICAS=3
KAFKA_RETENCION_MS=86400000

# Puertos (no chocan con catalogo-api 8081 ni rabbit-admin-api 8082)
# ms-productor-sensores=8085, ms-monitor-sensores=8086, kafka-admin-api=8084
# SERVER_PORT=8085   # definir por terminal solo si necesita otro puerto

# Topics y grupo
TOPICO_LECTURAS=sensores-temperatura
TOPICO_ALERTAS=sensores-alertas
GRUPO_KAFKA=grupo-monitor-s13
UMBRAL_ALERTA_C=30.0
